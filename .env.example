SHIOAJI_API_KEY='your_api_key_here'
SHIOAJI_SECRET_KEY='your_secret_key_here'
SHIOAJI_PERSON_ID='your_person_id_here'
SHIOAJI_SIMULATION='False'

# CA 憑證路徑：請改成你這台機器上 Sinopac.pfx 的實際位置
# Windows 範例：
# SHIOAJI_CA_PATH='C:/Users/yourname/txf_viewer_pro/Sinopac.pfx'
# Mac 範例：
# SHIOAJI_CA_PATH='/Users/yourname/txf_viewer_pro/Sinopac.pfx'
SHIOAJI_CA_PATH=''

SHIOAJI_CA_PASSWD='your_ca_password_here'

# Claude AI 個股分析（可選）：在 https://console.anthropic.com 取得
# 未設定時 Telegram 訊息仍正常發送，只是沒有 💡 AI分析行
ANTHROPIC_API_KEY=''
