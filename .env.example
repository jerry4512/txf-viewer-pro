FUBON_PERSON_ID='your_person_id_here'
FUBON_API_KEY='your_api_key_here'

# 憑證為選填；留空時使用 SDK 公開的 API Key DMA 登入。
# Windows 範例：
# FUBON_CERT_PATH='C:/Users/yourname/Downloads/fubon_cert.pfx'
# Mac 範例：
# FUBON_CERT_PATH='/Users/yourname/Downloads/fubon_cert.pfx'
FUBON_CERT_PATH=''
FUBON_CERT_PASS=''

# Telegram Bot Token：從 @BotFather 取得
# 例如：1234567890:ABCDefGHIJKlmnopQRStuvwxyz
TELEGRAM_BOT_TOKEN=''

# Claude AI 個股分析（可選）：在 https://console.anthropic.com 取得
# 未設定時 Telegram 訊息仍正常發送，只是沒有 💡 AI分析行
ANTHROPIC_API_KEY=''
